#!/bin/bash

# Configuration
VERSION="1.0.0"
ANDROID_HOME="$HOME/Library/Android/sdk"
if [[ "$OSTYPE" == "linux-gnu"* ]]; then
  ANDROID_HOME="$HOME/Android/Sdk"
fi

# Make sure tools in PATH during execution
export PATH="$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/emulator:$ANDROID_HOME/platform-tools:$PATH"

# Colors
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

function print_header() {
    echo -e "╭────────────────────────────────────╮"
    echo -e "│       Android Dev Environment      │"
    echo -e "╰────────────────────────────────────╯"
}

function show_help() {
    print_header
    echo "Usage: android-env <command>"
    echo ""
    echo "Commands:"
    echo "  setup     Install Android SDK, Platform Tools, and Emulator"
    echo "  doctor    Check environment status and missing dependencies"
    echo "  list      List available Android Virtual Devices (AVDs)"
    echo "  start     Start an emulator"
    echo "  version   Show version"
    echo ""
}

function check_command() {
    if command -v "$1" &> /dev/null; then
        echo -e "${GREEN}✓ $1 found${NC}"
        return 0
    else
        echo -e "${RED}✗ $1 not found${NC}"
        return 1
    fi
}

function do_doctor() {
    echo -e "\n${YELLOW}Android Environment Doctor${NC}\n"
    
    check_command "java"
    
    if [ -d "$ANDROID_HOME" ]; then
        echo -e "${GREEN}✓ ANDROID_HOME ($ANDROID_HOME)${NC}"
    else
        echo -e "${RED}✗ ANDROID_HOME not found${NC}"
    fi

    check_command "sdkmanager"
    check_command "adb"
    check_command "emulator"
    check_command "avdmanager"

    echo -e "\n${YELLOW}Installed AVDs:${NC}"
    if command -v avdmanager &> /dev/null; then
        avdmanager list avd -c
    else
        echo -e "${RED}avdmanager not found. Cannot list devices.${NC}"
    fi
    echo ""
}

function do_setup() {
    print_header
    echo -e "\nDetecting system..."

    # Detect OS
    if [[ "$OSTYPE" == "darwin"* ]]; then
        echo -e "${GREEN}✓ macOS detected${NC}"
        CMD_TOOLS_URL="https://dl.google.com/android/repository/commandlinetools-mac-11076708_latest.zip"
    else
        echo -e "${GREEN}✓ Linux detected${NC}"
        CMD_TOOLS_URL="https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip"
    fi

    # Detect Architecture
    SYS_IMAGE="system-images;android-34;google_apis;x86_64"
    if [[ $(uname -m) == 'arm64' || $(uname -m) == 'aarch64' ]]; then
        echo -e "${GREEN}✓ ARM64 Architecture detected${NC}"
        SYS_IMAGE="system-images;android-34;google_apis;arm64-v8a"
    else
        echo -e "${GREEN}✓ x86_64 Architecture detected${NC}"
    fi

    echo -e "\nInstalling SDK components..."
    
    mkdir -p "$ANDROID_HOME/cmdline-tools"
    
    if [ ! -d "$ANDROID_HOME/cmdline-tools/latest/bin" ]; then
        echo "Downloading Android Command Line Tools..."
        curl -s -o "$ANDROID_HOME/cmdline-tools.zip" "$CMD_TOOLS_URL"
        
        echo "Extracting tools..."
        unzip -q "$ANDROID_HOME/cmdline-tools.zip" -d "$ANDROID_HOME/cmdline-tools-temp"
        mkdir -p "$ANDROID_HOME/cmdline-tools/latest"
        mv "$ANDROID_HOME/cmdline-tools-temp/cmdline-tools/"* "$ANDROID_HOME/cmdline-tools/latest/"
        rm -rf "$ANDROID_HOME/cmdline-tools-temp" "$ANDROID_HOME/cmdline-tools.zip"
    else
        echo -e "${GREEN}✓ Command Line Tools already installed${NC}"
    fi

    echo -e "\nAccepting SDK Licenses (Automated)..."
    yes | sdkmanager --licenses > /dev/null 2>&1

    echo "Installing Platform Tools, Emulator, and API 34 System Image..."
    sdkmanager "platform-tools" "platforms;android-34" "emulator" "$SYS_IMAGE"

    echo -e "\nDownloading Modern Emulator Skins..."
    if [ ! -d "$ANDROID_HOME/skins/pixel_6_pro" ]; then
        echo "Fetching modern device frames from github (larskristianhaga)..."
        git clone -q https://github.com/larskristianhaga/Android-emulator-skins.git "$ANDROID_HOME/skins_temp"
        cp -r "$ANDROID_HOME/skins_temp"/* "$ANDROID_HOME/skins/" 2>/dev/null || true
        rm -rf "$ANDROID_HOME/skins_temp"
        echo -e "${GREEN}✓ Skins downloaded${NC}"
    else
        echo -e "${GREEN}✓ Skins already installed${NC}"
    fi

    echo -e "\nSelect Emulator Profile (with Frame):"
    echo "1) Pixel 6 Pro (1440x3120)"
    echo "2) Pixel 6 (1080x2400)"
    echo "3) Pixel 5 (1080x2340)"
    echo "p) Preview Skins in Browser"
    
    while true; do
        read -p "Enter choice (1, 2, 3, or p) [1]: " AVD_CHOICE
        if [ "$AVD_CHOICE" == "p" ]; then
            echo "Opening direct image previews on your computer..."
            if command -v open &> /dev/null; then
                open "$ANDROID_HOME/skins/pixel_6_pro/back.webp" 2>/dev/null
                open "$ANDROID_HOME/skins/pixel_6/back.webp" 2>/dev/null
                open "$ANDROID_HOME/skins/pixel_5/back.webp" 2>/dev/null
            elif command -v xdg-open &> /dev/null; then
                xdg-open "$ANDROID_HOME/skins/pixel_6_pro/back.webp" 2>/dev/null
                xdg-open "$ANDROID_HOME/skins/pixel_6/back.webp" 2>/dev/null
                xdg-open "$ANDROID_HOME/skins/pixel_5/back.webp" 2>/dev/null
            fi
            echo -e "${GREEN}✓ Previews opened!${NC}"
        else
            break
        fi
    done

    read -p "Enter a name for your Emulator (e.g. MyPixelPhone): " CUSTOM_NAME
    if [ -z "$CUSTOM_NAME" ]; then
        CUSTOM_NAME="My_Emulator"
    fi
    # Sanitize name (replace spaces with underscores)
    CUSTOM_NAME="${CUSTOM_NAME// /_}"

    if [ "$AVD_CHOICE" == "2" ]; then
        AVD_NAME="${CUSTOM_NAME}_API_34"
        DEV_NAME="pixel_6"
        SKIN_NAME="pixel_6"
    elif [ "$AVD_CHOICE" == "3" ]; then
        AVD_NAME="${CUSTOM_NAME}_API_34"
        DEV_NAME="pixel_5"
        SKIN_NAME="pixel_5"
    else
        AVD_NAME="${CUSTOM_NAME}_API_34"
        DEV_NAME="pixel_6_pro"
        SKIN_NAME="pixel_6_pro"
    fi

    echo -e "\nCreating Android Virtual Device ($AVD_NAME)..."
    if avdmanager list avd -c | grep -q "$AVD_NAME"; then
         echo -e "${GREEN}✓ AVD $AVD_NAME already exists${NC}"
    else
         echo "no" | avdmanager create avd -n "$AVD_NAME" -k "$SYS_IMAGE" --device "$DEV_NAME" --force
         
         # Apply Skin configuration
         AVD_CONFIG="$HOME/.android/avd/$AVD_NAME.avd/config.ini"
         if [ -f "$AVD_CONFIG" ]; then
             echo "skin.name = $SKIN_NAME" >> "$AVD_CONFIG"
             echo "skin.path = skins/$SKIN_NAME" >> "$AVD_CONFIG"
         fi
         echo -e "${GREEN}✓ AVD Created with $SKIN_NAME frame!${NC}"
    fi

    echo -e "\nCreating Desktop Shortcut ($CUSTOM_NAME)..."
    if [[ "$OSTYPE" == "darwin"* ]]; then
        # macOS App Shortcut
        osacompile -e "do shell script \"$ANDROID_HOME/emulator/emulator -avd $AVD_NAME > /dev/null 2>&1 &\"" -o "$HOME/Desktop/$CUSTOM_NAME.app" > /dev/null 2>&1
        echo -e "${GREEN}✓ Desktop App created at ~/Desktop/$CUSTOM_NAME.app${NC}"
    elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
        # Linux Desktop Shortcut
        DESKTOP_FILE="$HOME/Desktop/$CUSTOM_NAME.desktop"
        if [ ! -d "$HOME/Desktop" ]; then
            DESKTOP_FILE="$HOME/.local/share/applications/$CUSTOM_NAME.desktop"
        fi
        echo "[Desktop Entry]" > "$DESKTOP_FILE"
        echo "Version=1.0" >> "$DESKTOP_FILE"
        echo "Type=Application" >> "$DESKTOP_FILE"
        echo "Name=$CUSTOM_NAME" >> "$DESKTOP_FILE"
        echo "Exec=$ANDROID_HOME/emulator/emulator -avd $AVD_NAME" >> "$DESKTOP_FILE"
        echo "Terminal=false" >> "$DESKTOP_FILE"
        chmod +x "$DESKTOP_FILE"
        echo -e "${GREEN}✓ Desktop Shortcut created at $DESKTOP_FILE${NC}"
    elif [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" ]]; then
        # Windows Batch Shortcut (Git Bash)
        WIN_DESKTOP="$USERPROFILE/Desktop"
        echo "@echo off" > "$WIN_DESKTOP/$CUSTOM_NAME.bat"
        echo "start /B %LOCALAPPDATA%\Android\Sdk\emulator\emulator.exe -avd $AVD_NAME > NUL 2>&1" >> "$WIN_DESKTOP/$CUSTOM_NAME.bat"
        echo -e "${GREEN}✓ Windows Batch Shortcut created on Desktop${NC}"
    fi

    echo -e "\n${YELLOW}Setup Complete! 🚀${NC}"
    echo "To use these tools globally, add the following to your ~/.zshrc or ~/.bash_profile:"
    echo "export ANDROID_HOME=$ANDROID_HOME"
    echo "export PATH=\$ANDROID_HOME/emulator:\$ANDROID_HOME/platform-tools:\$ANDROID_HOME/cmdline-tools/latest/bin:\$PATH"
}

function do_list() {
    echo -e "${YELLOW}Available Android Virtual Devices:${NC}"
    if command -v avdmanager &> /dev/null; then
        avdmanager list avd -c
    else
        echo -e "${RED}Emulator tools not installed. Run 'android-env setup' first.${NC}"
    fi
}

function do_start() {
    AVD_NAME=$1
    if [ -z "$AVD_NAME" ]; then
        # Try to find a default one
        AVD_NAME=$(avdmanager list avd -c | head -n 1)
        if [ -z "$AVD_NAME" ]; then
            echo -e "${RED}No AVDs found. Run 'android-env setup' first.${NC}"
            exit 1
        fi
        echo "No AVD specified, using default: $AVD_NAME"
    fi
    
    echo -e "Starting emulator: ${YELLOW}$AVD_NAME${NC}..."
    nohup emulator -avd "$AVD_NAME" > /dev/null 2>&1 &
    echo -e "${GREEN}✓ Emulator booting in background${NC}"
}

# Main Command Router
case "$1" in
    setup)
        do_setup
        ;;
    doctor)
        do_doctor
        ;;
    list)
        do_list
        ;;
    start)
        do_start "$2"
        ;;
    version)
        echo "android-env version $VERSION"
        ;;
    *)
        show_help
        ;;
esac
